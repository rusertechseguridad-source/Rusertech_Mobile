<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del popup de eventos del mapa: superficie Deep Space opaca con
     borde Tech Glow, coherente con las tarjetas de la app (el bubble por
     defecto de osmdroid es blanco y queda fuera de la identidad visual). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/deep_space_top" />
    <stroke
        android:width="1dp"
        android:color="@color/tech_glow_cyan_40" />
    <corners android:radius="12dp" />
</shape>
