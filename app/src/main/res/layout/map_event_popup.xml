<?xml version="1.0" encoding="utf-8"?>
<!-- Popup de evento sobre el rastro del mapa.
     Los IDs bubble_* son el contrato de BasicInfoWindow de osmdroid: la
     librería los resuelve por nombre en el paquete de la app, así el popup
     usa esta superficie con tokens del proyecto en lugar del bubble blanco
     por defecto. bubble_subdescription se oculta solo si llega vacío. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_map_popup"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/bubble_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxWidth="240dp" />

    <TextView
        android:id="@+id/bubble_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxWidth="240dp" />

    <TextView
        android:id="@+id/bubble_subdescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:maxWidth="240dp" />
</LinearLayout>
